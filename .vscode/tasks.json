{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: uvicorn",
      "type": "shell",
      "command": ".\\venv\\Scripts\\Activate; uvicorn app.main:app --reload",
      "options": {
        "cwd": "${workspaceFolder}/Backend",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "label": "Backend",
        "group": "gymio",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Frontend: ng serve",
      "type": "shell",
      "command": "ng serve -o",
      "options": {
        "cwd": "${workspaceFolder}/Frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "label": "Frontend",
        "group": "gymio",
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🚀 Gymio: Start All",
      "dependsOn": ["Backend: uvicorn", "Frontend: ng serve"],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
